{
  "name": "@thiennc/flutter-skills",
  "version": "0.13.0",
  "description": "Install the Flutter Skills collection with one command.",
  "type": "module",
  "bin": {
    "flutter-skills": "cli/flutter-skills.mjs"
  },
  "files": [
    "cli",
    "lib",
    "skills/*/SKILL.md",
    "skills/*/references",
    "skills/*/scripts",
    "skills/*/assets",
    "cordis.patch.yml",
    "integrations/deepseek/en.json",
    "assets/antigravity-icon.png",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./locale/en.json": "./integrations/deepseek/en.json",
    "./icon": "./assets/antigravity-icon.png",
    "./*": "./*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/test_npm_cli.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "skills": "1.5.23"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thienqo/flutter-skills.git"
  },
  "homepage": "https://github.com/thienqo/flutter-skills#readme",
  "bugs": {
    "url": "https://github.com/thienqo/flutter-skills/issues"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "dart",
    "flutter"
  ],
  "license": "BSD-3-Clause"
}
